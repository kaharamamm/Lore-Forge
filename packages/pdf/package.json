{
  "name": "@lore-forge/pdf",
  "version": "0.4.0",
  "private": true,
  "description": "Renders Lore-Forge publish documents (World Codex, Story Book) to PDF with pdfkit and embedded DejaVu fonts.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
