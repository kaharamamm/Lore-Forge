  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@fontsource/almendra": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/medievalsharp": "^5.3.0",
    "@fontsource/metamorphous": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@lore-forge/core": "0.4.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.15.0",
    "fflate": "^0.8.3",
    "hyphen": "^1.14.1",
    "pdfkit": "^0.20.2"
  }
