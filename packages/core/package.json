{
  "name": "@lore-forge/core",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Lore-Forge world format, parser and consistency engine. Pure TypeScript, no Electron or DOM dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaharamamm/Lore-Forge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kaharamamm/Lore-Forge#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
