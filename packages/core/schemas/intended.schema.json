{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-forge.local/schemas/v1/intended.schema.json",
  "title": "Lore-Forge intended warnings (intended.json), schema version 1",
  "type": "object",
  "required": ["schemaVersion", "intended"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "intended": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["warningId"],
        "properties": { "warningId": { "type": "string" }, "note": { "type": "string" }, "markedAt": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
