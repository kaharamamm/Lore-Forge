{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lore-forge.local/schemas/v1/world-manifest.schema.json",
  "title": "Lore-Forge world manifest (world.json), schema version 1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "calendar"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "calendar": {
      "type": "object",
      "required": ["eras", "defaultEra"],
      "properties": {
        "eras": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "start"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z]\\w*$" },
              "name": { "type": "string" },
              "start": { "type": "integer", "description": "Absolute year on the world axis that year 1 of this era maps to." },
              "end": { "type": "integer", "description": "Optional last absolute year of the era; without it the era lasts until the next one starts." },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Optional colour of the era band on the timeline." }
            },
            "additionalProperties": false
          }
        },
        "defaultEra": { "type": "string" },
        "months": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "days"],
            "properties": { "name": { "type": "string" }, "days": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
          }
        },
        "approxYears": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "book": {
      "type": "object",
      "description": "Story Book export settings.",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "chapterYears": { "type": "integer", "minimum": 1, "description": "Split each era into chapters of this many years; default one chapter per era." },
        "trim": { "enum": ["6x9", "5.5x8.5", "a5"], "description": "Print trim size of the Story Book. Default 6x9 (inches)." },
        "rightHandChapters": { "type": "boolean", "description": "For printed books: start every chapter (and the title page, dedication, epigraph and contents) on a right-hand page, adding blank pages. Default false." },
        "dedication": { "type": "string", "description": "Optional dedication page text." },
        "epigraph": { "type": "string", "description": "Optional epigraph (opening quotation)." },
        "epigraphSource": { "type": "string", "description": "Who the epigraph is by." },
        "copyright": { "type": "string", "description": "Copyright page text; a plain notice with the author and year is used when empty." },
        "publisher": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cover": {
      "type": "object",
      "description": "How the world's book looks on the library shelf.",
      "properties": {
        "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "description": "Top of the cover gradient." },
        "color2": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$", "description": "Bottom of the cover gradient; the same as color for a plain cover." },
        "icon": { "type": "string", "description": "game-icons.net emblem name, or none." },
        "iconColor": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "image": { "type": "string", "description": "Cover picture, relative to the world folder, or none." },
        "titleStyle": { "enum": ["display", "serif", "sans"] },
        "titleColor": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "font": { "type": "string", "description": "Title font family: a bundled cover font or a system font." },
        "showTitle": { "type": "boolean", "description": "false hides the title on the front cover; it stays on the spine." },
        "showEmblem": { "type": "boolean", "description": "false hides the emblem on the front cover; it stays on the spine." },
        "spineColor": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "spineInk": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "additionalProperties": { "enum": ["error", "warning", "info", "off"] }
    }
  },
  "additionalProperties": false
}
